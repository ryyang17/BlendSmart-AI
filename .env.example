# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=blendsmart

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Agent behaviour ───────────────────────────────────────────────────────────
# Max documents returned per retrieval step
RETRIEVAL_TOP_K=5
# Min quality score (0.0–1.0) before the quality checker accepts an answer
QUALITY_THRESHOLD=0.7
